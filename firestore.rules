rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection check endpoint (read-only, contains no user data)
    match /test/connection {
      allow get: if true;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSpaceId(spaceId) {
      return spaceId == 'DAMA2';
    }

    function isListableSpaceId(spaceId) {
      return spaceId == 'DAMA2';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function defaultAdminUid(spaceId) {
      return spaceId == 'DAMA2' ? 'usr_mbfs_admin' : 'usr_mbfs_admin';
    }

    function bootstrapAdminAuthEmail(spaceId) {
      return spaceId == 'DAMA2' ? 'mbfs_admin@dama2.app' : 'mbfs_admin@dama2.app';
    }

    function isBootstrapAdminCaller(spaceId) {
      return isSignedIn() && request.auth.token.email == bootstrapAdminAuthEmail(spaceId);
    }

    // Hardcoded Super Admin Google email for DAMA2
    function isDefaultSpaceSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'dungtamtithoi24@gmail.com';
    }

    function isSpaceSuperAdmin(spaceId) {
      return spaceId == 'DAMA2' && isDefaultSpaceSuperAdmin();
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userExists(uid) {
      return isValidId(uid) && exists(/databases/$(database)/documents/users/$(uid));
    }

    function isActiveUser(uid) {
      return userExists(uid) && userDoc(uid).data.isActive == true && isValidSpaceId(userDoc(uid).data.departmentId);
    }

    function isActiveUserInSpace(uid, spaceId) {
      return isActiveUser(uid) && userDoc(uid).data.departmentId == spaceId;
    }

    function userHasRole(uid, role) {
      return isActiveUser(uid) && (role in userDoc(uid).data.roles);
    }

    function isAdminUser(uid) {
      return userHasRole(uid, 'ADMIN');
    }

    function isLeadershipUser(uid) {
      return isAdminUser(uid) || userHasRole(uid, 'TRUONG_PHONG') || userHasRole(uid, 'PHO_PHONG');
    }

    // Firebase Auth UID -> internal UserProfile binding check
    function hasAuthBinding() {
      return isSignedIn() && exists(/databases/$(database)/documents/authBindings/$(request.auth.uid));
    }

    function authBinding() {
      return get(/databases/$(database)/documents/authBindings/$(request.auth.uid));
    }

    function isBoundUserInSpace(spaceId) {
      return hasAuthBinding() &&
        authBinding().data.departmentId == spaceId &&
        authBinding().data.isActive == true &&
        isActiveUserInSpace(authBinding().data.userId, spaceId);
    }

    function isBoundSelf(userId) {
      return hasAuthBinding() &&
        authBinding().data.userId == userId &&
        authBinding().data.isActive == true;
    }

    function isSpaceMember(spaceId) {
      return isSpaceSuperAdmin(spaceId) || isBoundUserInSpace(spaceId);
    }

    function isSpaceAdmin(spaceId) {
      return isSpaceSuperAdmin(spaceId) || (isBoundUserInSpace(spaceId) && isAdminUser(authBinding().data.userId));
    }

    function isSpaceLeadership(spaceId) {
      return isSpaceSuperAdmin(spaceId) || (isBoundUserInSpace(spaceId) && isLeadershipUser(authBinding().data.userId));
    }

    // Vietnam Time (UTC+7) helpers for WorkLog date lock
    function vnTime() {
      return request.time + duration.time(7, 0, 0, 0);
    }

    function vnTodayNum() {
      return vnTime().year() * 10000 + vnTime().month() * 100 + vnTime().day();
    }

    function hasWorkLogUnlock(uid, workDate) {
      return exists(/databases/$(database)/documents/workLogUnlocks/$(uid + '_' + workDate));
    }

    function isWorkLogDateEditable(uid, workDate, workDateNum) {
      return isAdminUser(uid) || (
        workDateNum <= vnTodayNum() && (
          workDateNum == vnTodayNum() ||
          hasWorkLogUnlock(uid, workDate)
        )
      );
    }

    // --- Validation Blueprints ---

    function isValidSpaceKey(data) {
      return data.keys().hasAll(['spaceId', 'keyBase64', 'alg', 'createdAt']) &&
        data.keys().hasOnly(['spaceId', 'keyBase64', 'alg', 'createdAt']) &&
        isValidSpaceId(data.spaceId) &&
        data.keyBase64 is string && data.keyBase64.size() >= 32 && data.keyBase64.size() <= 128 &&
        data.alg == 'AES-256-GCM' &&
        data.createdAt is timestamp;
    }

    function isValidAuthBinding(data) {
      return data.keys().hasAll(['authUid', 'userId', 'departmentId', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['authUid', 'userId', 'departmentId', 'isActive', 'createdAt', 'updatedAt']) &&
        isValidId(data.authUid) &&
        isValidId(data.userId) &&
        isValidSpaceId(data.departmentId) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRolesList(roles) {
      return roles is list &&
        roles.size() >= 1 &&
        roles.size() <= 6 &&
        roles.hasOnly(['ADMIN', 'TRUONG_PHONG', 'PHO_PHONG', 'QUAN_LY_DU_AN', 'TRUONG_NHOM', 'CHUYEN_VIEN']);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'authUid', 'encryptedAccount', 'mustChangePassword', 'roles', 'isActive', 'departmentId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'authUid', 'encryptedAccount', 'mustChangePassword', 'roles', 'groupId', 'managerId', 'isActive', 'departmentId', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        isValidId(data.authUid) &&
        data.encryptedAccount is string && data.encryptedAccount.size() >= 24 && data.encryptedAccount.size() <= 4096 && data.encryptedAccount.matches('^aes256gcm\\$.*') &&
        data.mustChangePassword is bool &&
        isValidRolesList(data.roles) &&
        (!('groupId' in data) || (data.groupId is string && data.groupId.size() <= 64)) &&
        (!('managerId' in data) || (data.managerId is string && data.managerId.size() <= 128)) &&
        data.isActive is bool &&
        isValidSpaceId(data.departmentId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'encryptedPrivate', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'encryptedPrivate', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.encryptedPrivate is string && data.encryptedPrivate.size() >= 24 && data.encryptedPrivate.size() <= 2048 && data.encryptedPrivate.matches('^aes256gcm\\$.*') &&
        data.updatedAt is timestamp;
    }

    function isValidGroup(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'leaderId', 'memberUids', 'departmentId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'code', 'name', 'description', 'leaderId', 'memberUids', 'departmentId', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 32 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        data.leaderId is string && data.leaderId.size() <= 128 &&
        data.memberUids is list && data.memberUids.size() <= 50 &&
        (data.memberUids.size() == 0 || data.memberUids[0] is string) &&
        isValidSpaceId(data.departmentId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'status', 'pmId', 'memberIds', 'createdBy', 'departmentId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'code', 'name', 'description', 'startDate', 'expectedEndDate', 'status', 'pmId', 'memberIds', 'labels', 'createdBy', 'departmentId', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 32 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 20)) &&
        (!('expectedEndDate' in data) || (data.expectedEndDate is string && data.expectedEndDate.size() <= 20)) &&
        data.status in ['CHUAN_BI', 'DANG_THUC_HIEN', 'TAM_DUNG', 'HOAN_THANH', 'DONG'] &&
        isValidId(data.pmId) &&
        data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 50 && data.memberIds[0] is string &&
        (!('labels' in data) || (data.labels is list && data.labels.size() <= 15 && (data.labels.size() == 0 || data.labels[0] is string))) &&
        isValidId(data.createdBy) &&
        isValidSpaceId(data.departmentId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProjectMember(data) {
      return data.keys().hasAll(['userId', 'projectRole', 'joinedAt']) &&
        data.keys().hasOnly(['userId', 'projectRole', 'joinedAt']) &&
        isValidId(data.userId) &&
        data.projectRole in ['QUAN_LY_DU_AN', 'THANH_VIEN'] &&
        data.joinedAt is timestamp;
    }

    function isValidTask(data) {
      return data.keys().hasAll([
          'id', 'code', 'title', 'groupId', 'creatorId', 'assigneeId', 'reviewerId',
          'priority', 'status', 'submissionStatus', 'reviewResult', 'isLocked',
          'participantIds', 'departmentId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'code', 'title', 'description', 'projectId', 'groupId',
          'creatorId', 'assigneeId', 'reviewerId', 'parentTaskId', 'priority',
          'startDate', 'dueDate', 'estimatedHours', 'labels', 'attachments',
          'status', 'submissionStatus', 'submissionNote', 'reviewResult', 'reviewNote',
          'isLocked', 'participantIds', 'departmentId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 32 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
        (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 64)) &&
        data.groupId is string && data.groupId.size() <= 64 &&
        isValidId(data.creatorId) &&
        isValidId(data.assigneeId) &&
        isValidId(data.reviewerId) &&
        (!('parentTaskId' in data) || (data.parentTaskId is string && data.parentTaskId.size() <= 64)) &&
        data.priority in ['THAP', 'TRUNG_BINH', 'CAO', 'KHAN_CAP'] &&
        (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 20)) &&
        (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 20)) &&
        (!('estimatedHours' in data) || (data.estimatedHours is number && data.estimatedHours >= 0 && data.estimatedHours <= 10000)) &&
        (!('labels' in data) || (data.labels is list && data.labels.size() <= 10 && (data.labels.size() == 0 || data.labels[0] is string))) &&
        (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 10 && (data.attachments.size() == 0 || data.attachments[0] is string))) &&
        data.status in ['MOI', 'DANG_THUC_HIEN', 'CHO_XAC_NHAN', 'CHUA_HOAN_THANH', 'HOAN_THANH', 'TAM_HOAN', 'HUY'] &&
        data.submissionStatus in ['CHUA_NOP', 'DA_NOP'] &&
        (!('submissionNote' in data) || (data.submissionNote is string && data.submissionNote.size() <= 1000)) &&
        data.reviewResult in ['CHO_XAC_NHAN', 'DA_HOAN_THANH', 'CHUA_HOAN_THANH'] &&
        (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 1000)) &&
        data.isLocked is bool &&
        data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 50 && data.participantIds[0] is string &&
        isValidSpaceId(data.departmentId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSubtask(data) {
      return data.keys().hasAll(['id', 'title', 'isDone', 'createdBy', 'taskParticipantIds', 'createdAt']) &&
        data.keys().hasOnly(['id', 'title', 'isDone', 'createdBy', 'taskParticipantIds', 'createdAt']) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.isDone is bool &&
        isValidId(data.createdBy) &&
        data.taskParticipantIds is list && data.taskParticipantIds.size() >= 1 && data.taskParticipantIds.size() <= 50 && data.taskParticipantIds[0] is string &&
        data.createdAt is timestamp;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'authorId', 'authorName', 'content', 'taskParticipantIds', 'createdAt']) &&
        data.keys().hasOnly(['id', 'authorId', 'authorName', 'content', 'mentions', 'taskParticipantIds', 'createdAt']) &&
        isValidId(data.id) &&
        isActiveUser(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
        (!('mentions' in data) || (data.mentions is list && data.mentions.size() <= 20 && (data.mentions.size() == 0 || data.mentions[0] is string))) &&
        data.taskParticipantIds is list && data.taskParticipantIds.size() >= 1 && data.taskParticipantIds.size() <= 50 && data.taskParticipantIds[0] is string &&
        data.createdAt is timestamp;
    }

    function isValidTaskAuditLog(data) {
      return data.keys().hasAll(['id', 'actorId', 'actorName', 'action', 'detail', 'taskParticipantIds', 'createdAt']) &&
        data.keys().hasOnly(['id', 'actorId', 'actorName', 'action', 'detail', 'taskParticipantIds', 'createdAt']) &&
        isValidId(data.id) &&
        isActiveUser(data.actorId) &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 1000 &&
        data.taskParticipantIds is list && data.taskParticipantIds.size() >= 1 && data.taskParticipantIds.size() <= 50 && data.taskParticipantIds[0] is string &&
        data.createdAt is timestamp;
    }

    function isValidWorkLog(data) {
      return data.keys().hasAll(['id', 'userId', 'taskId', 'workDate', 'workDateNum', 'hours', 'note', 'viewerIds', 'departmentId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'taskId', 'projectId', 'workDate', 'workDateNum', 'hours', 'progressPercent', 'note', 'viewerIds', 'departmentId', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidId(data.taskId) &&
        (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 64)) &&
        data.workDate is string && data.workDate.size() == 10 && data.workDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.workDateNum is int && data.workDateNum >= 20200101 && data.workDateNum <= 21001231 &&
        data.hours is number && data.hours > 0 && data.hours <= 24 &&
        (!('progressPercent' in data) || (data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100)) &&
        data.note is string && data.note.size() >= 1 && data.note.size() <= 1000 &&
        data.viewerIds is list && data.viewerIds.size() >= 1 && data.viewerIds.size() <= 30 && data.viewerIds[0] is string &&
        isValidSpaceId(data.departmentId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkLogUnlock(data) {
      return data.keys().hasAll(['id', 'userId', 'workDate', 'unlockedBy', 'reason', 'departmentId', 'unlockedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'workDate', 'unlockedBy', 'reason', 'departmentId', 'unlockedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.workDate is string && data.workDate.size() == 10 && data.workDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.id == (data.userId + '_' + data.workDate) &&
        isLeadershipUser(data.unlockedBy) &&
        data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 500 &&
        isValidSpaceId(data.departmentId) &&
        data.unlockedAt is timestamp;
    }

    function isValidSystemConfig(data) {
      return data.keys().hasAll(['lockHour', 'lockMinute', 'reminderHour', 'reminderMinute', 'timezone', 'defaultLabels', 'updatedAt']) &&
        data.keys().hasOnly(['lockHour', 'lockMinute', 'reminderHour', 'reminderMinute', 'timezone', 'defaultLabels', 'holidays', 'departmentId', 'updatedBy', 'updatedAt']) &&
        data.lockHour is int && data.lockHour >= 0 && data.lockHour <= 23 &&
        data.lockMinute is int && data.lockMinute >= 0 && data.lockMinute <= 59 &&
        data.reminderHour is int && data.reminderHour >= 0 && data.reminderHour <= 23 &&
        data.reminderMinute is int && data.reminderMinute >= 0 && data.reminderMinute <= 59 &&
        data.timezone is string && data.timezone.size() <= 40 &&
        data.defaultLabels is list && data.defaultLabels.size() <= 30 && (data.defaultLabels.size() == 0 || data.defaultLabels[0] is string) &&
        (!('holidays' in data) || (data.holidays is list && data.holidays.size() <= 50 && (data.holidays.size() == 0 || data.holidays[0] is string))) &&
        (!('departmentId' in data) || isValidSpaceId(data.departmentId)) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'actorId', 'actorName', 'action', 'targetType', 'targetId', 'detail', 'viewerIds', 'departmentId', 'createdAt']) &&
        data.keys().hasOnly(['id', 'actorId', 'actorName', 'action', 'targetType', 'targetId', 'detail', 'viewerIds', 'departmentId', 'createdAt']) &&
        isValidId(data.id) &&
        isActiveUser(data.actorId) &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 40 &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 1000 &&
        data.viewerIds is list && data.viewerIds.size() >= 1 && data.viewerIds.size() <= 30 && data.viewerIds[0] is string &&
        isValidSpaceId(data.departmentId) &&
        data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. Legacy gmailDatabases disabled (DAMA2 single-department mode)
    match /gmailDatabases/{ownerUid} {
      allow read, write: if false;
    }

    // 2. Per-Space AES-256-GCM Encryption Keys (NEVER allow list; get strictly for verified space members/super-admin)
    match /spaceKeys/{spaceId} {
      allow get: if isValidSpaceId(spaceId) && isSignedIn() && (
        isSpaceMember(spaceId) ||
        (
          isBootstrapAdminCaller(spaceId) &&
          (
            !exists(/databases/$(database)/documents/users/$(defaultAdminUid(spaceId))) ||
            !('authUid' in get(/databases/$(database)/documents/users/$(defaultAdminUid(spaceId))).data)
          )
        )
      );
      allow list: if false;
      allow create: if isValidSpaceId(spaceId) && isSignedIn() &&
        isValidSpaceKey(incoming()) &&
        incoming().spaceId == spaceId &&
        incoming().createdAt == request.time && (
          isSpaceSuperAdmin(spaceId) ||
          (
            isBootstrapAdminCaller(spaceId) &&
            (
              !exists(/databases/$(database)/documents/users/$(defaultAdminUid(spaceId))) ||
              !('authUid' in get(/databases/$(database)/documents/users/$(defaultAdminUid(spaceId))).data)
            )
          )
        );
      allow update, delete: if false;
    }

    // 3. Firebase Auth UID -> UserProfile Bindings (NEVER allow list)
    match /authBindings/{authUid} {
      allow get: if isValidId(authUid) && isSignedIn() && (
        request.auth.uid == authUid ||
        (resource != null && isSpaceAdmin(existing().departmentId))
      );
      allow list: if false;
      allow create: if isValidId(authUid) && isSignedIn() &&
        isValidAuthBinding(incoming()) &&
        incoming().authUid == authUid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isSpaceAdmin(incoming().departmentId) ||
          (
            authUid == request.auth.uid &&
            incoming().userId == defaultAdminUid(incoming().departmentId) &&
            isBootstrapAdminCaller(incoming().departmentId) &&
            exists(/databases/$(database)/documents/users/$(incoming().userId)) &&
            get(/databases/$(database)/documents/users/$(incoming().userId)).data.authUid == request.auth.uid
          )
        );
      allow update: if isValidId(authUid) && isSignedIn() &&
        isValidAuthBinding(incoming()) &&
        incoming().authUid == existing().authUid &&
        incoming().userId == existing().userId &&
        incoming().departmentId == existing().departmentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isSpaceAdmin(existing().departmentId);
      allow delete: if isValidId(authUid) && isSignedIn() &&
        existing().userId != defaultAdminUid(existing().departmentId) &&
        isSpaceSuperAdmin(existing().departmentId);
    }

    // 4. Legacy authCredentials (read/write disabled; super-admin delete only for cleanup)
    match /authCredentials/{credId} {
      allow read, create, update: if false;
      allow delete: if isSignedIn() && resource != null && isSpaceSuperAdmin(existing().departmentId);
    }

    // 5. Users (Account PII encrypted in encryptedAccount; zero unauthenticated reads)
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (
        (resource == null && (hasAuthBinding() || isDefaultSpaceSuperAdmin())) ||
        (resource != null && isSpaceMember(existing().departmentId)) ||
        (
          userId == defaultAdminUid('DAMA2') &&
          isBootstrapAdminCaller('DAMA2') &&
          (resource == null || !('authUid' in existing()) || existing().authUid == '')
        )
      );
      allow list: if isSignedIn() &&
        isListableSpaceId(resource.data.departmentId) &&
        isSpaceMember(resource.data.departmentId);

      allow create: if isValidId(userId) && isSignedIn() &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isSpaceAdmin(incoming().departmentId) ||
          (
            userId == defaultAdminUid(incoming().departmentId) &&
            isBootstrapAdminCaller(incoming().departmentId) &&
            incoming().authUid == request.auth.uid &&
            incoming().roles.size() == 1 &&
            ('ADMIN' in incoming().roles) &&
            incoming().isActive == true
          )
        );

      allow update: if isValidId(userId) && isSignedIn() &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().departmentId == existing().departmentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isSpaceAdmin(existing().departmentId) ||
          (
            isBoundSelf(userId) &&
            incoming().authUid == existing().authUid &&
            incoming().roles == existing().roles &&
            incoming().isActive == existing().isActive &&
            incoming().diff(existing()).affectedKeys().hasOnly(['mustChangePassword', 'encryptedAccount', 'updatedAt'])
          ) ||
          (
            userId == defaultAdminUid(existing().departmentId) &&
            (!('authUid' in existing()) || existing().authUid == '') &&
            isBootstrapAdminCaller(existing().departmentId) &&
            incoming().authUid == request.auth.uid &&
            incoming().roles == existing().roles &&
            incoming().isActive == true
          )
        );

      allow delete: if isValidId(userId) && isSignedIn() &&
        userId != defaultAdminUid(existing().departmentId) &&
        isSpaceSuperAdmin(existing().departmentId);

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isSignedIn() && (
          isBoundSelf(userId) ||
          (userExists(userId) && isSpaceAdmin(userDoc(userId).data.departmentId))
        );
        allow create, update: if isValidId(userId) && isValidId(docId) && isSignedIn() &&
          isValidUserPrivate(incoming()) &&
          incoming().uid == userId &&
          incoming().updatedAt == request.time &&
          userExists(userId) &&
          isSpaceAdmin(userDoc(userId).data.departmentId);
        allow delete: if isValidId(userId) && isValidId(docId) && isSignedIn() &&
          userExists(userId) &&
          isSpaceSuperAdmin(userDoc(userId).data.departmentId);
      }
    }

    // 6. Work Groups
    match /groups/{groupId} {
      allow get: if isValidId(groupId) && isSignedIn() && (
        (resource == null && (hasAuthBinding() || isDefaultSpaceSuperAdmin())) ||
        (resource != null && isSpaceMember(existing().departmentId))
      );
      allow list: if isSignedIn() &&
        isListableSpaceId(resource.data.departmentId) &&
        isSpaceMember(resource.data.departmentId);

      allow create: if isValidId(groupId) && isSignedIn() &&
        isValidGroup(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isSpaceAdmin(incoming().departmentId);
      allow update: if isValidId(groupId) && isSignedIn() &&
        isValidGroup(incoming()) &&
        incoming().id == existing().id &&
        incoming().departmentId == existing().departmentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isSpaceAdmin(existing().departmentId);
      allow delete: if isValidId(groupId) && isSignedIn() && isSpaceSuperAdmin(existing().departmentId);
    }

    // 7. Projects
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isSignedIn() && (
        (resource == null && (hasAuthBinding() || isDefaultSpaceSuperAdmin())) ||
        (resource != null && isSpaceMember(existing().departmentId))
      );
      allow list: if isSignedIn() &&
        isListableSpaceId(resource.data.departmentId) &&
        isSpaceMember(resource.data.departmentId);

      allow create: if isValidId(projectId) && isSignedIn() &&
        isValidProject(incoming()) &&
        isSpaceMember(incoming().departmentId) &&
        isActiveUserInSpace(incoming().createdBy, incoming().departmentId) &&
        (isSpaceSuperAdmin(incoming().departmentId) || incoming().createdBy == authBinding().data.userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(projectId) && isSignedIn() &&
        isValidProject(incoming()) &&
        isSpaceMember(existing().departmentId) &&
        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().departmentId == existing().departmentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(projectId) && isSignedIn() && isSpaceSuperAdmin(existing().departmentId);

      match /members/{memberId} {
        allow get: if isValidId(projectId) && isValidId(memberId) && isSignedIn() &&
          exists(/databases/$(database)/documents/projects/$(projectId)) &&
          isSpaceMember(get(/databases/$(database)/documents/projects/$(projectId)).data.departmentId);
        allow list: if isValidId(projectId) && isSignedIn() &&
          exists(/databases/$(database)/documents/projects/$(projectId)) &&
          isSpaceMember(get(/databases/$(database)/documents/projects/$(projectId)).data.departmentId);
        allow create, update: if isValidId(projectId) && isValidId(memberId) && isSignedIn() &&
          isValidProjectMember(incoming()) &&
          incoming().joinedAt == request.time &&
          exists(/databases/$(database)/documents/projects/$(projectId)) &&
          isSpaceMember(get(/databases/$(database)/documents/projects/$(projectId)).data.departmentId);
        allow delete: if isValidId(projectId) && isValidId(memberId) && isSignedIn() &&
          exists(/databases/$(database)/documents/projects/$(projectId)) &&
          isSpaceSuperAdmin(get(/databases/$(database)/documents/projects/$(projectId)).data.departmentId);
      }
    }

    // 8. Tasks
    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && isSignedIn() && (
        (resource == null && (hasAuthBinding() || isDefaultSpaceSuperAdmin())) ||
        (resource != null && isSpaceMember(existing().departmentId))
      );
      allow list: if isSignedIn() &&
        isListableSpaceId(resource.data.departmentId) &&
        isSpaceMember(resource.data.departmentId);

      allow create: if isValidId(taskId) && isSignedIn() &&
        isValidTask(incoming()) &&
        isSpaceMember(incoming().departmentId) &&
        isActiveUserInSpace(incoming().creatorId, incoming().departmentId) &&
        (isSpaceSuperAdmin(incoming().departmentId) || incoming().creatorId == authBinding().data.userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (!('projectId' in incoming()) || incoming().projectId == '' || exists(/databases/$(database)/documents/projects/$(incoming().projectId)));

      allow update: if isValidId(taskId) && isSignedIn() &&
        isValidTask(incoming()) &&
        isSpaceMember(existing().departmentId) &&
        incoming().id == existing().id &&
        incoming().code == existing().code &&
        incoming().creatorId == existing().creatorId &&
        incoming().departmentId == existing().departmentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          existing().isLocked == false ||
          (
            existing().isLocked == true &&
            incoming().isLocked == false &&
            incoming().status == 'DANG_THUC_HIEN' &&
            incoming().submissionStatus == 'CHUA_NOP' &&
            incoming().reviewResult == 'CHUA_HOAN_THANH' &&
            'reviewNote' in incoming() && incoming().reviewNote.size() >= 3 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'submissionStatus', 'reviewResult', 'reviewNote', 'isLocked', 'updatedAt'])
          )
        );

      allow delete: if isValidId(taskId) && isSignedIn() && isSpaceSuperAdmin(existing().departmentId);

      match /subtasks/{subtaskId} {
        allow get, list: if isValidId(taskId) && isSignedIn() &&
          exists(/databases/$(database)/documents/tasks/$(taskId)) &&
          isSpaceMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.departmentId);
        allow create, update: if isValidId(taskId) && isValidId(subtaskId) && isSignedIn() &&
          isValidSubtask(incoming()) &&
          exists(/databases/$(database)/documents/tasks/$(taskId)) &&
          isSpaceMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.departmentId);
        allow delete: if isValidId(taskId) && isValidId(subtaskId) && isSignedIn() &&
          exists(/databases/$(database)/documents/tasks/$(taskId)) &&
          isSpaceSuperAdmin(get(/databases/$(database)/documents/tasks/$(taskId)).data.departmentId);
      }

      match /comments/{commentId} {
        allow get, list: if isValidId(taskId) && isSignedIn() &&
          exists(/databases/$(database)/documents/tasks/$(taskId)) &&
          isSpaceMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.departmentId);
        allow create: if isValidId(taskId) && isValidId(commentId) && isSignedIn() &&
          isValidComment(incoming()) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/tasks/$(taskId)) &&
          isSpaceMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.departmentId);
        allow delete: if isValidId(taskId) && isValidId(commentId) && isSignedIn() &&
          exists(/databases/$(database)/documents/tasks/$(taskId)) &&
          isSpaceSuperAdmin(get(/databases/$(database)/documents/tasks/$(taskId)).data.departmentId);
      }

      match /auditLogs/{logId} {
        allow get, list: if isValidId(taskId) && isSignedIn() &&
          exists(/databases/$(database)/documents/tasks/$(taskId)) &&
          isSpaceMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.departmentId);
        allow create: if isValidId(taskId) && isValidId(logId) && isSignedIn() &&
          isValidTaskAuditLog(incoming()) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/tasks/$(taskId)) &&
          isSpaceMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.departmentId);
        allow delete: if isValidId(taskId) && isValidId(logId) && isSignedIn() &&
          exists(/databases/$(database)/documents/tasks/$(taskId)) &&
          isSpaceSuperAdmin(get(/databases/$(database)/documents/tasks/$(taskId)).data.departmentId);
      }
    }

    // 9. WorkLogs (enforces Vietnam UTC+7 date lock on server)
    match /workLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (
        (resource == null && (hasAuthBinding() || isDefaultSpaceSuperAdmin())) ||
        (resource != null && isSpaceMember(existing().departmentId))
      );
      allow list: if isSignedIn() &&
        isListableSpaceId(resource.data.departmentId) &&
        isSpaceMember(resource.data.departmentId);

      allow create: if isValidId(logId) && isSignedIn() &&
        isValidWorkLog(incoming()) &&
        isSpaceMember(incoming().departmentId) &&
        isActiveUserInSpace(incoming().userId, incoming().departmentId) &&
        (isSpaceSuperAdmin(incoming().departmentId) || incoming().userId == authBinding().data.userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/tasks/$(incoming().taskId)) &&
        isWorkLogDateEditable(incoming().userId, incoming().workDate, incoming().workDateNum);

      allow update: if isValidId(logId) && isSignedIn() &&
        isValidWorkLog(incoming()) &&
        isSpaceMember(existing().departmentId) &&
        isActiveUser(existing().userId) &&
        (isSpaceSuperAdmin(existing().departmentId) || existing().userId == authBinding().data.userId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().workDate == existing().workDate &&
        incoming().workDateNum == existing().workDateNum &&
        incoming().departmentId == existing().departmentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isWorkLogDateEditable(existing().userId, existing().workDate, existing().workDateNum);

      allow delete: if isValidId(logId) && isSignedIn() && (
        (isSpaceMember(existing().departmentId) && isActiveUser(existing().userId) && (isSpaceSuperAdmin(existing().departmentId) || existing().userId == authBinding().data.userId) && isWorkLogDateEditable(existing().userId, existing().workDate, existing().workDateNum)) ||
        isSpaceSuperAdmin(existing().departmentId)
      );
    }

    // 10. WorkLog Unlocks (Leadership/Admin only)
    match /workLogUnlocks/{unlockId} {
      allow get: if isValidId(unlockId) && isSignedIn() && (
        (resource == null && (hasAuthBinding() || isDefaultSpaceSuperAdmin())) ||
        (resource != null && isSpaceMember(existing().departmentId))
      );
      allow list: if isSignedIn() &&
        isListableSpaceId(resource.data.departmentId) &&
        isSpaceMember(resource.data.departmentId);
      allow create, update: if isValidId(unlockId) && isSignedIn() &&
        isValidWorkLogUnlock(incoming()) &&
        isSpaceLeadership(incoming().departmentId) &&
        unlockId == incoming().id &&
        incoming().unlockedAt == request.time;
      allow delete: if isValidId(unlockId) && isSignedIn() && isSpaceSuperAdmin(existing().departmentId);
    }

    // 11. System Configs
    match /systemConfigs/{configId} {
      allow get: if isValidId(configId) && isSignedIn() &&
        isSpaceMember(configId == 'department' ? 'DAMA2' : configId);
      allow create, update: if isValidId(configId) && isSignedIn() &&
        isValidSystemConfig(incoming()) &&
        incoming().updatedAt == request.time &&
        (configId == 'department' || incoming().departmentId == configId) && (
          isSpaceAdmin(configId == 'department' ? 'DAMA2' : configId) ||
          (
            !exists(/databases/$(database)/documents/systemConfigs/$(configId)) &&
            isBootstrapAdminCaller(configId == 'department' ? 'DAMA2' : configId)
          )
        );
      allow delete: if isValidId(configId) && isSignedIn() &&
        isSpaceSuperAdmin(configId == 'department' ? 'DAMA2' : configId);
    }

    // 12. System Audit Logs
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (
        (resource == null && (hasAuthBinding() || isDefaultSpaceSuperAdmin())) ||
        (resource != null && isSpaceMember(existing().departmentId))
      );
      allow list: if isSignedIn() &&
        isListableSpaceId(resource.data.departmentId) &&
        isSpaceMember(resource.data.departmentId);
      allow create: if isValidId(logId) && isSignedIn() &&
        isValidAuditLog(incoming()) &&
        isSpaceMember(incoming().departmentId) &&
        isActiveUserInSpace(incoming().actorId, incoming().departmentId) &&
        incoming().createdAt == request.time;
      allow delete: if isValidId(logId) && isSignedIn() && isSpaceSuperAdmin(existing().departmentId);
    }
  }
}
